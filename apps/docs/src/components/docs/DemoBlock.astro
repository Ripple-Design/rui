---
import { codeToHtml } from "shiki"

export interface Props {
    title: string
    code: string
    language?: string
}

const {title, code, language = "vue"} = Astro.props
const highlightedCode = codeToHtml(code.trimEnd(), {
    lang: language,
    theme: "github-light",
})
---

<section class="demo-block">
    <div class="demo-preview">
        <button class="demo-preview__fullscreen-trigger" type="button">Fullscreen</button>
        <slot/>
    </div>
    <details class="demo-source">
        <summary>Show code</summary>
        <div class="demo-source__content" set:html={highlightedCode}/>
    </details>

    <script>
        document.querySelectorAll<HTMLElement>(".demo-block").forEach((block) => {
            const preview = block.querySelector<HTMLElement>(".demo-preview")
            const fullscreenButton = block.querySelector<HTMLButtonElement>(".demo-preview__fullscreen-trigger")

            fullscreenButton?.addEventListener("click", () => {
                if (document.fullscreenElement === preview) {
                    void document.exitFullscreen()
                    return
                }

                void preview?.requestFullscreen()
            })

            document.addEventListener("fullscreenchange", () => {
                const isFullscreen = document.fullscreenElement === preview
                fullscreenButton.textContent = isFullscreen ? "Exit fullscreen" : "Fullscreen"
                fullscreenButton.setAttribute("aria-pressed", String(isFullscreen))
            })
        })
    </script>
</section>

<style lang="scss">
    @use "@ripple-design/rui/rui";

    .demo-block {
        display: grid;
        gap: 1rem;
    }

    .demo-block h2 {
        margin: 0;
    }

    .demo-preview,
    .demo-source {
        border-radius: 4px;
        border: 1px solid #D0D0D0;
    }

    .demo-preview {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px;
        gap: 16px;
        background: rui.$color-background;
    }

    .demo-preview:fullscreen {
        box-sizing: border-box;
        inline-size: 100vw;
        block-size: 100vh;
        padding: 48px;
        overflow: auto;
    }

    .demo-preview__fullscreen-trigger {
        position: absolute;
        z-index: 1;
        inset-block-start: 8px;
        inset-inline-end: 8px;
        border: 0;
        border-radius: 4px;
        cursor: pointer;
        padding: 0.5rem 0.75rem;
        background: #111111;
        color: #FFFFFF;
        font: inherit;
    }

    .demo-preview__fullscreen-trigger:focus-visible {
        outline: 2px solid #111111;
        outline-offset: 2px;
    }

    .demo-source {
        background: #F7F7F7;
    }

    .demo-source summary {
        cursor: pointer;
        font-weight: 600;
        padding: 0.875rem 1rem;
    }

    .demo-source summary:focus-visible {
        outline: 2px solid #111111;
        outline-offset: 2px;
    }

    .demo-source__content {
        border-top: 1px solid #D0D0D0;
        overflow-x: auto;
    }

    .demo-source__content :global(pre) {
        background: transparent !important;
        margin: 0;
        overflow-x: auto;
        padding: 1rem;
    }
</style>
