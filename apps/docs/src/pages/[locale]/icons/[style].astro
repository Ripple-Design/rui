---
import BaseLayout from "../../../layouts/BaseLayout.astro"
import IconsExplorer from "../../../components/icons/IconsExplorer.vue"
import { locales, type Locale } from "../../../lib/docs"
import { ICON_STYLES, type IconVariant } from "../../../lib/icons"

export function getStaticPaths() {
    return locales.flatMap((locale) =>
        ICON_STYLES.filter((style) => style !== ICON_STYLES[0]).map((style) => ({
            params: { locale, style },
        })),
    )
}

const { locale, style } = Astro.params as { locale: Locale; style: IconVariant }
const currentStyle = ICON_STYLES.includes(style) ? style : ICON_STYLES[0]
const currentDir = Astro.url.searchParams.get("dir")
---

<BaseLayout title="Icons" locale={locale} currentUrl={Astro.url} sectionLabel="Components">
    <IconsExplorer client:only="vue" locale={locale} current-style={currentStyle} current-dir={currentDir} />
</BaseLayout>
