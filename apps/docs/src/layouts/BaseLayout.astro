---
import "@ripple-design/rui/styles.css"
import DocsScaffoldShell from "../components/docs/DocsScaffoldShell.vue"
import { createDocsThemeBootstrapScript } from "@docs/lib/theme"
import { getDirectionMode, getLocaleUrl, locales } from "../lib/docs"
import type { ComponentsNavigation } from "../lib/docs"

export interface Props {
    title: string
    locale: string
    currentUrl?: URL
    sectionLabel?: string
    componentsNavigation?: ComponentsNavigation
}

const { title, locale, currentUrl = Astro.url, sectionLabel = "Components", componentsNavigation } = Astro.props
const direction = getDirectionMode(currentUrl)
const docsThemeBootstrapScript = createDocsThemeBootstrapScript()
const navigation = [
    { label: sectionLabel, href: `/${locale}/getting-started/spec`, value: "components" },
    { label: "Icons", href: `/${locale}/icons`, value: "icons" },
    { label: "API", href: `/${locale}/api/text-field`, value: "api" },
]
const activeNavigation = currentUrl.pathname.startsWith(`/${locale}/icons`)
    ? "icons"
    : currentUrl.pathname.startsWith(`/${locale}/api`)
        ? "api"
        : "components"
const localeLinks = locales.map((item) => ({
    code: item,
    href: getLocaleUrl(currentUrl, item),
}))
---

<!doctype html>
<html lang={locale} dir={direction}>
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            rel="stylesheet"
            href="https://fonts.googleapis.com/css2?family=Roboto+Flex:opsz,wght@8..144,100..1000&family=Roboto:wght@300;400;500;700&display=swap"
        />
        <title>{title}</title>
        <style lang="scss">
            @use "@ripple-design/rui/rui" as rui;

            :root {
                color-scheme: light dark;
                font-family: var(--rui-sys-typo-font-family);
            }

            html,
            body {
                block-size: 100%;
            }

            body {
                @include rui.typo-body1;

                min-block-size: 100%;
                margin: 0;
                overflow: hidden;
                background: var(--rui-sys-color-background);
                color: rui.$color-on-surface;
            }

            a,
            button,
            input {
                color: inherit;
                font: inherit;
            }

        </style>
        <script is:inline set:html={docsThemeBootstrapScript}></script>
    </head>
    <body>
        <DocsScaffoldShell
            client:load
            activeNavigation={activeNavigation}
            componentsNavigation={componentsNavigation}
            direction={direction}
            locale={locale}
            localeLinks={localeLinks}
            navigation={navigation}
        >
            <slot />
        </DocsScaffoldShell>
    </body>
</html>
