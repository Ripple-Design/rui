---
import "@ripple-design/rui/styles.css"
import ThemeControlSheet from "@docs/components/docs/ThemeControlSheet.vue"
import { getDirectionMode, getLocaleUrl, locales } from "../lib/docs"

export interface Props {
    title: string
    locale: string
    currentUrl?: URL
    sectionLabel?: string
}

const { title, locale, currentUrl = Astro.url, sectionLabel = "Components" } = Astro.props
const direction = getDirectionMode(currentUrl)
---

<!doctype html>
<html lang={locale} dir={direction}>
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <title>{title}</title>
        <style>
            :root {
                color-scheme: light dark;
                font-family: Arial, sans-serif;
                line-height: 1.5;
            }

            body {
                margin: 0;
                background: var(--rui-sys-color-background);
            }

            a,
            button,
            input {
                color: inherit;
                font: inherit;
            }

            .site-header {
                border-bottom: 1px solid #d0d0d0;
                padding: 1rem;
            }

            .site-header__inner {
                display: grid;
                gap: 1rem;
                align-items: start;
            }

            .site-title {
                margin: 0;
                font-size: 1.25rem;
            }

            .header-nav,
            .header-tools,
            .header-direction,
            .header-theme {
                display: flex;
                flex-wrap: wrap;
                gap: 1rem;
            }

            .header-nav ul,
            .header-tools ul,
            .header-direction ul,
            .header-theme ul {
                display: flex;
                flex-wrap: wrap;
                gap: 0.75rem;
                list-style: none;
                padding: 0;
                margin: 0;
            }

            .page-shell {
                width: min(1440px, 100% - 2rem);
                margin: 0 auto;
                padding: 1rem 0 2rem;
            }

            @media (min-width: 900px) {
                .site-header__inner {
                    grid-template-columns: 1fr auto auto auto auto;
                }
            }
        </style>
        <script is:inline>
            const DOCS_THEME_KEY = "rui-docs-theme"
            const DOCS_THEME_MODE_KEY = "rui-docs-theme-mode"
            const current = new URL(window.location.href)
            const readStorage = (key) => {
                try {
                    return localStorage.getItem(key)
                } catch {
                    return null
                }
            }
            const defaultTheme = {
                color: {
                    primary: "#6200ee",
                    primaryLight: "#bb86fc",
                    primaryDark: "#3700b3",
                    onPrimary: "#ffffff",
                    secondary: "#03dac6",
                    secondaryLight: "#70efde",
                    secondaryDark: "#00b3a6",
                    onSecondary: "#000000",
                    background: "#eeeeee",
                    onBackground: "#000000",
                    surface: "#fafafa",
                    surfaceDark: "#f5f5f5",
                    onSurface: "#000000",
                    error: "#b00020",
                    onError: "#ffffff",
                },
                density: 0,
                iconStyle: "filled",
                shape: {
                    small: { family: "rounded" },
                    medium: { family: "rounded" },
                    large: { family: "rounded" },
                    full: { family: "rounded" },
                },
            }
            const defaultDarkTheme = {
                color: {
                    primary: "#bb86fc",
                    primaryLight: "#e2b8ff",
                    primaryDark: "#8856c7",
                    onPrimary: "#000000",
                    secondary: "#03dac6",
                    secondaryLight: "#66fff8",
                    secondaryDark: "#00a896",
                    onSecondary: "#000000",
                    background: "#121212",
                    onBackground: "#ffffff",
                    surface: "#1e1e1e",
                    surfaceDark: "#171717",
                    onSurface: "#ffffff",
                    error: "#cf6679",
                    onError: "#000000",
                },
                density: 0,
                iconStyle: "filled",
                shape: {
                    small: { family: "rounded" },
                    medium: { family: "rounded" },
                    large: { family: "rounded" },
                    full: { family: "rounded" },
                },
            }
            const defaultDayNightTheme = {
                day: defaultTheme,
                night: defaultDarkTheme,
            }
            const allowedDensity = new Set([0, -1, -2, -3])
            const allowedIconStyles = new Set(["filled", "outlined", "rounded", "sharp", "twotone"])
            const allowedThemeModes = new Set(["day", "night", "system"])
            const normalizeThemePatch = (theme) => {
                const next = typeof theme === "object" && theme != null ? theme : {}
                const density = allowedDensity.has(next.density) ? next.density : defaultTheme.density
                const iconStyle = allowedIconStyles.has(next.iconStyle) ? next.iconStyle : defaultTheme.iconStyle
                const shapeFamily = next.shape?.small?.family === "cut" ? "cut" : defaultTheme.shape.small.family
                const legacyPrimary =
                    typeof next.color?.primary === "string" && next.color.primary ? next.color.primary : undefined
                const dayPrimary =
                    typeof next.day?.color?.primary === "string" && next.day.color.primary
                        ? next.day.color.primary
                        : legacyPrimary
                const nightPrimary =
                    typeof next.night?.color?.primary === "string" && next.night.color.primary
                        ? next.night.color.primary
                        : undefined
                return {
                    density,
                    iconStyle,
                    shape: {
                        small: { family: shapeFamily },
                        medium: { family: shapeFamily },
                        large: { family: shapeFamily },
                        full: { family: shapeFamily },
                    },
                    day: dayPrimary ? { color: { primary: dayPrimary } } : {},
                    night: nightPrimary ? { color: { primary: nightPrimary } } : {},
                }
            }
            const mergeTheme = (base, next) => ({
                color: { ...base.color, ...next.color },
                density: next.density ?? base.density,
                iconStyle: next.iconStyle ?? base.iconStyle,
                shape: {
                    small: { ...base.shape?.small, ...next.shape?.small },
                    medium: { ...base.shape?.medium, ...next.shape?.medium },
                    large: { ...base.shape?.large, ...next.shape?.large },
                    full: { ...base.shape?.full, ...next.shape?.full },
                },
            })
            const resolveMode = (mode) => {
                if (mode === "system") {
                    return window.matchMedia("(prefers-color-scheme: dark)").matches ? "night" : "day"
                }

                return mode
            }
            const resolveDayNightTheme = (defaults, patch) => {
                const { day, night, ...shared } = patch
                return {
                    day: mergeTheme(mergeTheme(defaults.day, shared), day ?? {}),
                    night: mergeTheme(mergeTheme(defaults.night, shared), night ?? {}),
                }
            }
            const COLOR_MAP = [
                ["primary", "--rui-sys-color-primary"],
                ["primaryLight", "--rui-sys-color-primary-light"],
                ["primaryDark", "--rui-sys-color-primary-dark"],
                ["onPrimary", "--rui-sys-color-on-primary"],
                ["secondary", "--rui-sys-color-secondary"],
                ["secondaryLight", "--rui-sys-color-secondary-light"],
                ["secondaryDark", "--rui-sys-color-secondary-dark"],
                ["onSecondary", "--rui-sys-color-on-secondary"],
                ["background", "--rui-sys-color-background"],
                ["onBackground", "--rui-sys-color-on-background"],
                ["surface", "--rui-sys-color-surface"],
                ["surfaceDark", "--rui-sys-color-surface-dark"],
                ["onSurface", "--rui-sys-color-on-surface"],
                ["onSurfaceHigh", "--rui-sys-color-on-surface-high"],
                ["onSurfaceMedium", "--rui-sys-color-on-surface-medium"],
                ["onSurfaceLow", "--rui-sys-color-on-surface-low"],
                ["onSurfaceOutline", "--rui-sys-color-on-surface-outline"],
                ["error", "--rui-sys-color-error"],
                ["onError", "--rui-sys-color-on-error"],
            ]
            const applyTheme = (theme) => {
                const style = document.documentElement.style
                const colors = theme.color

                if (colors) {
                    for (const [key, cssVar] of COLOR_MAP) {
                        if (colors[key]) {
                            style.setProperty(cssVar, colors[key])
                        }
                    }
                }

                if (theme.density != null) {
                    style.setProperty("--rui-sys-density-scale", String(theme.density))
                }
                if (theme.iconStyle) {
                    style.setProperty("--rui-sys-icon-style", theme.iconStyle)
                }

                const cssFamily = theme.shape?.small?.family === "cut" ? "bevel" : "round"
                for (const category of ["small", "medium", "large", "full"]) {
                    style.setProperty(`--rui-sys-shape-${category}-family`, cssFamily)
                }
            }

            const dir = current.searchParams.get("dir") === "rtl"
                ? "rtl"
                : readStorage("rui-docs-dir") === "rtl"
                    ? "rtl"
                    : "ltr"
            const rawTheme = readStorage(DOCS_THEME_KEY)
            const rawMode = readStorage(DOCS_THEME_MODE_KEY)
            const parsedTheme = rawTheme ? (() => {
                try {
                    return JSON.parse(rawTheme)
                } catch {
                    return {}
                }
            })() : {}
            const patch = normalizeThemePatch(parsedTheme)
            const mode = allowedThemeModes.has(rawMode) ? rawMode : "system"
            const resolvedMode = resolveMode(mode)
            const themes = resolveDayNightTheme(defaultDayNightTheme, patch)
            const activeTheme = themes[resolvedMode]

            document.documentElement.setAttribute("dir", dir)
            document.documentElement.dataset.ruiTheme = resolvedMode
            document.documentElement.style.colorScheme = resolvedMode === "night" ? "dark" : "light"
            applyTheme(activeTheme)
        </script>
    </head>
    <body>
        <header class="site-header">
            <div class="site-header__inner">
                <p class="site-title">Ripple Design</p>
                <nav class="header-nav" aria-label="Primary">
                    <ul>
                        <li><a href={`/${locale}/getting-started/spec`}>{sectionLabel}</a></li>
                        <li><a href={`/${locale}/icons`}>Icons</a></li>
                        <li><a href={`/${locale}/api/text-field`}>API</a></li>
                    </ul>
                </nav>
                <nav class="header-tools" aria-label="Language switcher">
                    <ul>
                        {locales.map((item) => (
                            <li>
                                <a href={getLocaleUrl(currentUrl, item)} data-locale-link={item} aria-current={item === locale ? "true" : undefined}>
                                    {item}
                                </a>
                            </li>
                        ))}
                    </ul>
                </nav>
                <nav class="header-direction" aria-label="Direction switcher">
                    <ul>
                        <li>
                            <button type="button" data-dir-toggle="ltr" aria-pressed={direction === "ltr" ? "true" : "false"}>LTR</button>
                        </li>
                        <li>
                            <button type="button" data-dir-toggle="rtl" aria-pressed={direction === "rtl" ? "true" : "false"}>RTL</button>
                        </li>
                    </ul>
                </nav>
                <nav class="header-theme" aria-label="Theme controls">
                    <ThemeControlSheet client:load />
                </nav>
            </div>
        </header>
        <main class="page-shell">
            <slot />
        </main>
        <script is:inline>
            const url = new URL(window.location.href)
            const activeDir = document.documentElement.getAttribute("dir") === "rtl" ? "rtl" : "ltr"

            document.querySelectorAll("[data-dir-toggle]").forEach((node) => {
                node.setAttribute("aria-pressed", node.getAttribute("data-dir-toggle") === activeDir ? "true" : "false")
                node.addEventListener("click", () => {
                    const dir = node.getAttribute("data-dir-toggle")
                    if (!dir) return
                    url.searchParams.set("dir", dir)
                    localStorage.setItem("rui-docs-dir", dir)
                    document.documentElement.setAttribute("dir", dir)
                    document.querySelectorAll("[data-dir-toggle]").forEach((button) => {
                        button.setAttribute("aria-pressed", button.getAttribute("data-dir-toggle") === dir ? "true" : "false")
                    })
                    history.replaceState({}, "", `${url.pathname}${url.search}`)
                })
            })

            document.querySelectorAll("[data-locale-link]").forEach((node) => {
                const href = node.getAttribute("href")
                if (!href) return
                const next = new URL(href, window.location.origin)
                if (url.searchParams.has("mode")) {
                    next.searchParams.set("mode", url.searchParams.get("mode") ?? "")
                }
                if (url.searchParams.has("dir")) {
                    next.searchParams.set("dir", url.searchParams.get("dir") ?? "")
                } else if (localStorage.getItem("rui-docs-dir") === "rtl") {
                    next.searchParams.set("dir", "rtl")
                }
                node.setAttribute("href", `${next.pathname}${next.search}`)
            })
        </script>
    </body>
</html>
