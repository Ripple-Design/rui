---
import BaseLayout from "./BaseLayout.astro"
import "../styles/docs-prose.scss"
import type { CollectionEntry } from "astro:content"
import { RSurface } from "@ripple-design/rui"
import type { ComponentsNavigation, OutlineItem } from "../lib/docs"
import { getReadingMode, getTabsForDoc, groupDocs } from "../lib/docs"
import DocsTabBar from "../components/docs/DocsTabBar.vue"

export interface Props {
    entry: CollectionEntry<"docs">
    locale: string
    allDocs: CollectionEntry<"docs">[]
    outline: OutlineItem[]
}

const { entry, locale, allDocs, outline } = Astro.props
const mode = getReadingMode(Astro.url)
const groupedDocs = groupDocs(allDocs, locale, mode)

function getDocsHref(docSlug: string, tab: string) {
    const next = new URL(Astro.url)
    next.pathname = `/${locale}/${docSlug}/${tab}`
    return `${next.pathname}${next.search}`
}

const componentsNavigation: ComponentsNavigation = {
    activeValue: entry.data.docSlug,
    groups: groupedDocs.map(({ group, items }) => ({
        group,
        items: items.map((item) => ({
            href: getDocsHref(item.data.docSlug, item.data.tab),
            label: item.data.title,
            value: item.data.docSlug,
        })),
    })),
}
const tabs = getTabsForDoc(allDocs, locale, entry.data.docSlug).map((tabEntry) => ({
    value: tabEntry.data.tab,
    label: tabEntry.data.tab,
    href: getDocsHref(tabEntry.data.docSlug, tabEntry.data.tab),
}))
---

<BaseLayout
    title={entry.data.title}
    locale={locale}
    currentUrl={Astro.url}
    sectionLabel="Components"
    componentsNavigation={componentsNavigation}
>
    <style lang="scss">
        @use "@ripple-design/rui/styles/index" as rui;

        .docs-shell {
            display: grid;
            gap: 1.5rem;
        }

        .docs-outline {
            padding: 1.25rem;
            color: rui.$color-on-surface;
        }

        .docs-outline h2 {
            @include rui.typo-headline6;

            margin: 0 0 1rem;
        }

        .docs-outline h3 {
            @include rui.typo-subtitle2;

            margin: 0 0 0.5rem;
        }

        .docs-outline a {
            @include rui.typo-body2;

            color: rui.$color-on-surface-high;
        }

        .docs-outline a:hover,
        .docs-outline a:focus-visible {
            color: rui.$color-primary;
        }

        .docs-content ul,
        .docs-outline ul {
            margin: 0;
            padding-inline-start: 1.25rem;
        }

        .docs-mobile-navigation {
            margin-block-end: 1.5rem;
        }

        .docs-mobile-navigation summary {
            @include rui.typo-subtitle2;

            cursor: pointer;
        }

        .docs-mobile-navigation h2 {
            @include rui.typo-subtitle2;

            margin: 1rem 0 0;
        }

        .docs-mobile-navigation ol {
            margin: 1rem 0 0;
            padding-inline-start: 1.25rem;
        }

        .docs-mobile-navigation section + section {
            margin-block-start: 1rem;
        }

        .docs-content header {
            margin-bottom: 1.5rem;
        }

        .docs-content h1 {
            @include rui.typo-headline4;

            margin: 0;
            color: rui.$color-on-surface;
        }

        .docs-links a {
            @include rui.typo-subtitle2;

            color: rui.$color-primary;
        }

        .docs-mode,
        .docs-tabs,
        .docs-links {
            margin-top: 1rem;
        }

        .docs-outline ul {
            list-style: none;
            padding-left: 0;
        }

        .docs-outline li + li {
            margin-top: 0.5rem;
        }

        .docs-outline li[data-depth="3"] {
            padding-left: 1rem;
        }

        .docs-outline li[data-depth="4"] {
            padding-left: 2rem;
        }

        @media (min-width: 1200px) {
            .docs-shell {
                grid-template-columns: minmax(0, 1fr) 14rem;
                align-items: start;
            }

            .docs-mobile-navigation {
                display: none;
            }

            .docs-outline {
                position: sticky;
                top: 1rem;
            }
        }
    </style>

    <div class="docs-shell">
        <aside class="docs-mobile-navigation">
            <details>
                <summary>Components</summary>
                {componentsNavigation.groups.map((group) => (
                    <section>
                        <h2>{group.group}</h2>
                        <ol>
                            {group.items.map((item) => (
                                <li>
                                    <a href={item.href} aria-current={item.value === componentsNavigation.activeValue ? "page" : undefined}>
                                        {item.label}
                                    </a>
                                </li>
                            ))}
                        </ol>
                    </section>
                ))}
            </details>
        </aside>

        <article class="docs-content">
            <header>
                <h1>{entry.data.title}</h1>
                <!--<p>Current reading mode: {mode}</p>-->
                <!--<nav class="docs-mode" aria-label="Reading mode">-->
                <!--    <ul>-->
                <!--        <li><a href={getModeUrl(Astro.url, "design")} aria-current={mode === "design" ? "true" : undefined}>Design</a></li>-->
                <!--        <li><a href={getModeUrl(Astro.url, "develop")} aria-current={mode === "develop" ? "true" : undefined}>Develop</a></li>-->
                <!--    </ul>-->
                <!--</nav>-->
                <DocsTabBar client:load activeTab={entry.data.tab} tabs={tabs} />
                <p class="docs-links">
                    <a href={entry.data.api}>View API</a>
                </p>
            </header>

            <div class="docs-body">
                <slot />
            </div>
        </article>

        <RSurface as="aside" variant="outlined" class="docs-outline">
            <nav aria-label="Current section outline">
                <h2>On this page</h2>
                <h3>{entry.data.tab}</h3>
                <ul>
                    {outline.length > 0 ? (
                        outline.map((item) => (
                            <li data-depth={item.depth}>
                                <a href={`#${item.slug}`}>{item.text}</a>
                            </li>
                        ))
                    ) : (
                        <li>No subsection headings yet.</li>
                    )}
                </ul>
            </nav>
        </RSurface>
    </div>
</BaseLayout>
