{
    "name": "rui-workspace",
    "version": "1.0.0",
    "private": true,
    "packageManager": "pnpm@10.2.0",
    "description": "",
    "keywords": [],
    "license": "MIT",
    "author": "",
    "main": "index.js",
    "scripts": {
        "docs": "pnpm --filter docs dev",
        "generate:api-docs": "node scripts/generate-api-docs.mjs",
        "build:video-player": "pnpm --filter rux-video-player build",
        "build:data-table": "pnpm --filter rux-data-table build",
        "build:chat": "pnpm --filter rux-chat build",
        "build:date-time-picker": "pnpm --filter rux-date-time-picker build",
        "build:font-picker": "pnpm --filter rux-font-picker build",
        "lint:rui": "pnpm --filter rui lint",
        "lint:video-player": "pnpm --filter rux-video-player lint",
        "lint:data-table": "pnpm --filter rux-data-table lint",
        "lint:chat": "pnpm --filter rux-chat lint",
        "lint:date-time-picker": "pnpm --filter rux-date-time-picker lint",
        "lint:font-picker": "pnpm --filter rux-font-picker lint",
        "lint:rui:fix": "pnpm --filter rui lint:fix"
    },
    "dependencies": {
        "vue": "catalog:"
    },
    "devDependencies": {
        "@tsconfig/node24": "^24.0.4",
        "@types/node": "^24.13.2",
        "@vue/tsconfig": "^0.9.1",
        "oxfmt": "^0.54.0",
        "oxlint": "~1.69.0",
        "typescript": "~6.0.0",
        "vue-tsc": "^2.2.10"
    }
}
