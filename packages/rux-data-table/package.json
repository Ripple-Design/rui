{
    "name": "@ripple-design/rux-data-table",
    "version": "1.1.2",
    "description": "Data table package for Vue 3",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Ripple-Design/rui.git",
        "directory": "packages/rux-data-table"
    },
    "files": [
        "dist"
    ],
    "type": "module",
    "sideEffects": [
        "**/*.css"
    ],
    "main": "dist/es/index.js",
    "module": "dist/es/index.js",
    "types": "dist/types/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/types/index.d.ts",
            "import": "./dist/es/index.js"
        },
        "./styles.css": "./dist/assets/styles.css"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "vue-tsc -b --noEmit tsconfig.json && vite build",
        "lint": "oxlint .",
        "lint:fix": "oxlint . --fix",
        "test": "vitest run"
    },
    "dependencies": {
        "@ripple-design/icons": "^1.0.7"
    },
    "devDependencies": {
        "@ripple-design/rui": "workspace:*",
        "@vitejs/plugin-vue": "catalog:",
        "@vue/test-utils": "catalog:",
        "jsdom": "catalog:",
        "vite": "catalog:",
        "vite-plugin-dts": "catalog:",
        "vitest": "catalog:"
    },
    "peerDependencies": {
        "@ripple-design/rui": "^1.9.0",
        "vue": "^3.5.0"
    }
}
