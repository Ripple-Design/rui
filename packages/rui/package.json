{
    "name": "@ripple-design/rui",
    "version": "1.6.0",
    "description": "Modular and customizable Ripple Design UI components for Vue 3",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Ripple-Design/rui.git",
        "directory": "packages/rui"
    },
    "files": [
        "dist",
        "src/styles",
        "src/foundations",
        "rui.scss"
    ],
    "type": "module",
    "sideEffects": [
        "**/*.css",
        "**/*.scss"
    ],
    "main": "dist/es/index.js",
    "module": "dist/es/index.js",
    "types": "dist/types/src/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/types/src/index.d.ts",
            "import": "./dist/es/index.js"
        },
        "./playground": {
            "types": "./dist/types/src/playground/index.d.ts",
            "import": "./dist/es/playground/index.js"
        },
        "./styles.css": "./dist/rui.css",
        "./rui": "./rui.scss",
        "./rui.scss": "./rui.scss"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "vue-tsc -b --noEmit tsconfig.json && vite build",
        "lint": "oxlint .",
        "lint:fix": "oxlint . --fix"
    },
    "dependencies": {
        "@floating-ui/dom": "^1.8.0",
        "@ripple-design/icons": "^1.0.7"
    },
    "devDependencies": {
        "@vitejs/plugin-vue": "catalog:",
        "sass": "^1.93.2",
        "vite": "catalog:",
        "vite-plugin-dts": "catalog:"
    },
    "peerDependencies": {
        "vue": "^3.5.0"
    },
    "optionalDependencies": {
        "@lottiefiles/dotlottie-vue": "^0.11.24"
    },
    "sass": "./rui.scss"
}
