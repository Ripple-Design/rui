{
    "name": "@ripple-design/rui",
    "version": "1.7.5",
    "description": "Modular and customizable Ripple Design UI components for Vue 3",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Ripple-Design/rui.git",
        "directory": "packages/rui"
    },
    "files": [
        "dist",
        "src/styles",
        "src/foundations"
    ],
    "type": "module",
    "sideEffects": [
        "**/*.css",
        "**/*.scss"
    ],
    "main": "dist/es/index.js",
    "module": "dist/es/index.js",
    "types": "dist/types/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/types/index.d.ts",
            "import": "./dist/es/index.js",
            "sass": "./src/styles/index.scss"
        },
        "./playground": {
            "types": "./dist/types/playground/index.d.ts",
            "import": "./dist/es/playground/index.js"
        },
        "./foundations/*": {
            "types": "./dist/types/foundations/*.d.ts",
            "import": "./dist/es/foundations/*.js"
        },
        "./styles.css": "./dist/assets/styles.css",
        "./styles/*": "./src/styles/*.scss"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "vue-tsc -b --noEmit tsconfig.json && vite build",
        "lint": "oxlint .",
        "lint:fix": "oxlint . --fix",
        "test": "vitest run"
    },
    "dependencies": {
        "@floating-ui/dom": "^1.8.0",
        "@ripple-design/icons": "^1.0.7"
    },
    "devDependencies": {
        "@vitejs/plugin-vue": "catalog:",
        "@vue/test-utils": "catalog:",
        "jsdom": "catalog:",
        "sass": "^1.93.2",
        "vite": "catalog:",
        "vite-plugin-dts": "catalog:",
        "vitest": "catalog:"
    },
    "peerDependencies": {
        "vue": "^3.5.0"
    },
    "optionalDependencies": {
        "@lottiefiles/dotlottie-vue": "^0.11.24"
    },
    "sass": "src/styles/index.scss"
}
